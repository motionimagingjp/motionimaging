# Vercel Cron 認証（Vercelが自動で Authorization: Bearer を付与）
CRON_SECRET=
# Upstash Redis（ミゴロンとは別DBを推奨）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Instagram（JONGJINアカウント用）
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Threads（JONGJINアカウント用。未設定ならスキップ）
THREADS_ACCESS_TOKEN=
# 画像の公開URLのベース（未設定ならリクエストのドメインを使用）例: https://vert5x-jongjin.vercel.app
SITE_URL=
# 在庫・エラー通知（Discord Webhook。未設定なら通知なし）
DISCORD_WEBHOOK_URL=
